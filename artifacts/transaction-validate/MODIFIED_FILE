import { createHmac, timingSafeEqual } from "node:crypto";

export function validateTelegramInitData(initData: string, botToken: string) {
  if (!initData || initData.length > 16384 || !botToken) return false;
  const params = new URLSearchParams(initData);
  const receivedHash = params.get("hash");
  if (!receivedHash || !/^[a-fA-F0-9]{64}$/.test(receivedHash)) return false;
  if (new Set(params.keys()).size !== [...params.keys()].length) return false;

  params.delete("hash");

  const dataCheckString = [...params.entries()]
    .sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)
    .map(([key, value]) => `${key}=${value}`)
    .join("\n");

  const secretKey = createHmac("sha256", "WebAppData").update(botToken).digest();
  const calculatedHash = createHmac("sha256", secretKey)
    .update(dataCheckString)
    .digest("hex");

  const a = Buffer.from(receivedHash, "hex");
  const b = Buffer.from(calculatedHash, "hex");

  return a.length === b.length && timingSafeEqual(a, b);
}
